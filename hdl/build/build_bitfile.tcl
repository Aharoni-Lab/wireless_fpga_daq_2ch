# build_bitfile.tcl -- reproducible headless build of the two-channel bitfile.
#
# Usage, from the repo root:
#     vivado -mode batch -source hdl/build/build_bitfile.tcl -tclargs 12
#
# The single argument is the c_shift_ram_0 Depth, which sets the Manchester data
# rate for BOTH channels: rate_MHz = 100 / Depth. 12 -> 8.33 MHz, 10 -> 10 MHz.
# Defaults to 12.
#
# Why this exists: every bitfile in hdl/build/ before this script was built by
# hand, at least one of them from an uncommitted source edit, so none could be
# regenerated from a committed tree and their rate labels could not be checked.
# This script sets the rate explicitly, records WNS/WHS next to the result, and
# writes the recovered-clock routing report that tells you whether dec_clk and
# dec2_clk were actually timed.

set depth 12
if {$argc >= 1} { set depth [lindex $argv 0] }
# Optional second argument: a directory to drop the bitfile and its provenance
# stamp into, instead of hdl/build. Used for variant builds (different debug pin
# mapping, say) that must not overwrite the committed set -- they share filenames
# because miniscope-io parses the scheme and it has no slot for a variant.
set outdir ""
if {$argc >= 2} { set outdir [lindex $argv 1] }
if {![string is integer -strict $depth] || $depth < 1} {
    error "Depth must be a positive integer, got '$depth'"
}
set rate_mhz [expr {100.0 / $depth}]

set here [file normalize [file dirname [info script]]]
set xpr  [file join $here wireless_daq.xpr]
if {![file exists $xpr]} { error "project not found: $xpr" }

puts "=== build_bitfile.tcl: Depth $depth -> [format %.2f $rate_mhz] MHz ==="
open_project $xpr

# Rate. Regenerate the IP only when the value actually changes, so a repeat
# build with the same rate does not needlessly invalidate synthesis.
# Always set and always regenerate. Skipping generate_target when the .xci
# already reads the requested Depth assumes the generated output matches the
# .xci, and it does not have to: editing the .xci outside Vivado leaves stale
# generated files behind, and the build would then silently produce a bitfile at
# whatever rate was generated last while labelling it with the requested one.
# That is the provenance failure this script exists to prevent, so pay the
# regeneration cost every time.
set ip [get_ips c_shift_ram_0]
puts "setting c_shift_ram_0 Depth to $depth (was [get_property CONFIG.Depth $ip])"
set_property CONFIG.Depth $depth $ip
generate_target all $ip
synth_ip $ip -force -quiet
reset_run synth_1

# Always resynthesise. A finished run keeps PROGRESS at 100% even when the RTL
# or the constraints have changed underneath it, so trusting that is how you end
# up shipping a bitfile that does not match the tree it claims to come from --
# which is the exact problem this script exists to prevent.
# Rate-exact recovered-clock constraints.
#
# xem7310.xdc constrains dec_clk/dec2_clk at a fixed 70 ns (14.3 MHz) so a GUI
# build still gets them timed. That is conservative for Depth >= 7 but LOOSER
# than reality above it, which would let a too-fast build pass timing without
# anything actually being checked. Write an override carrying the real period
# for this Depth and process it last, so it replaces the default.
set bit_period [expr {$depth * 10.0}]
set rate_xdc [file join $here recovered_clock_rate.xdc]
set fh [open $rate_xdc w]
puts $fh "# GENERATED by build_bitfile.tcl -- do not edit, do not commit."
puts $fh "# Depth $depth => bit period [format %.3f $bit_period] ns ([format %.2f $rate_mhz] MHz)."
puts $fh "# Replaces the fixed-period defaults in xem7310.xdc."
puts $fh "create_clock -name dec_clk  -period [format %.3f $bit_period] \[get_pins dec/o_clk\]"
puts $fh "create_clock -name dec2_clk -period [format %.3f $bit_period] \[get_pins dec2/o_clk\]"
close $fh
if {[llength [get_files -quiet [file tail $rate_xdc]]] == 0} {
    add_files -fileset constrs_1 $rate_xdc
}
set_property PROCESSING_ORDER LATE [get_files [file tail $rate_xdc]]
puts "rate constraint: dec_clk/dec2_clk at [format %.3f $bit_period] ns"

set jobs 8
reset_run synth_1
launch_runs synth_1 -jobs $jobs
wait_on_run synth_1
if {[get_property STATUS [get_runs synth_1]] ne "synth_design Complete!"} {
    error "synthesis failed -- see [get_property DIRECTORY [get_runs synth_1]]/runme.log"
}

reset_run impl_1
launch_runs impl_1 -to_step write_bitstream -jobs $jobs
wait_on_run impl_1
if {[get_property PROGRESS [get_runs impl_1]] ne "100%"} {
    error "implementation failed -- see [get_property DIRECTORY [get_runs impl_1]]/runme.log"
}

set wns [get_property STATS.WNS [get_runs impl_1]]
set whs [get_property STATS.WHS [get_runs impl_1]]

# Recovered-clock routing. Without the create_clock statements in xem7310.xdc
# these two clocks do not appear here at all, and a clean timing summary means
# nothing for either decoder.
if {[llength [get_designs -quiet]] > 0} { close_design }
open_run impl_1
set rpt [file join $here recovered_clocks.rpt]
report_clock_networks -file $rpt
report_clock_utilization -append -file $rpt

set found {}
foreach c {dec_clk dec2_clk} {
    if {[llength [get_clocks -quiet $c]] == 1} {
        lappend found "$c period [get_property PERIOD [get_clocks $c]] ns"
    } else {
        lappend found "$c NOT DEFINED -- decoder paths are unconstrained"
    }
}

# Refuse before copying. Writing the bitfile out under its scheme name first and
# erroring afterwards would leave a timing-failed build sitting where the next
# person picks it up as good.
if {$wns < 0 || $whs < 0} {
    set rundir [get_property DIRECTORY [get_runs impl_1]]
    error "TIMING FAILED (WNS $wns ns, WHS $whs ns) -- bitfile not copied out. Reports are in $rundir"
}

set impl_dir [get_property DIRECTORY [get_runs impl_1]]
set src [file join $impl_dir USBInterface.bit]
set rate_label [string map {. _} [format %.2f $rate_mhz]]
set rate_label [string trimright $rate_label "0"]
set rate_label [string trimright $rate_label "_"]
set destdir $here
if {$outdir ne ""} {
    set destdir [file normalize [file join $here $outdir]]
    file mkdir $destdir
}
set dst [file join $destdir "USBInterface-${rate_label}mhz-J2_2+J2_4-3v3-IEEE.bit"]
file copy -force $src $dst

set stamp [file join $destdir "[file rootname [file tail $dst]].txt"]
set fh [open $stamp w]
puts $fh "bitfile:      [file tail $dst]"
puts $fh "built:        [clock format [clock seconds] -format {%Y-%m-%d %H:%M:%S}]"
puts $fh "vivado:       [version -short]"
puts $fh "git commit:   [exec git -C $here rev-parse HEAD]"
puts $fh "git dirty:    [expr {[string length [exec git -C $here status --porcelain]] ? {yes} : {no}}]"
puts $fh "shift depth:  $depth  (=> [format %.2f $rate_mhz] MHz on both channels)"
puts $fh "WNS:          $wns ns"
puts $fh "WHS:          $whs ns"
foreach f $found { puts $fh "clock:        $f" }
close $fh

puts "=== done ==="
puts "bitfile:  $dst"
puts "provenance: $stamp"
puts "WNS $wns ns, WHS $whs ns"
foreach f $found { puts "  $f" }
close_project
